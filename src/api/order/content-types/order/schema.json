{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "usuarioId": {
      "type": "string",
      "required": true
    },
    "total": {
      "type": "decimal",
      "required": true
    },
    "estado": {
      "type": "string",
      "default": "pendiente"
    },
    "metodoPago": {
      "type": "string"
    },
    "detallesEnvio": {
      "type": "string",
      "required": true
    },
    "correo": {
      "type": "email",
      "required": true
    },
    "voucher": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
